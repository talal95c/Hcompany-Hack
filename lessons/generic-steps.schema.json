{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compagnon générique à entrées réelles",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "help_ladder": {
          "type": "object",
          "properties": {
            "1": {
              "type": "string",
              "minLength": 1
            },
            "2": {
              "type": "string",
              "minLength": 1
            },
            "3": {
              "type": "string",
              "minLength": 1
            },
            "4": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "1",
            "2",
            "3",
            "4"
          ],
          "additionalProperties": false
        },
        "expected_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "click"
                  },
                  "target": {
                    "$ref": "#/$defs/generic_target"
                  },
                  "modifiers": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "shift",
                        "ctrl",
                        "alt"
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "kind",
                  "target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "key"
                  },
                  "keys": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "keys"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "type"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "known_errors_extra": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "$ref": "#/$defs/check"
              },
              "hint": {
                "type": "string",
                "minLength": 1
              },
              "mistake_actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "click"
                        },
                        "target": {
                          "$ref": "#/$defs/generic_target"
                        },
                        "modifiers": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "shift",
                              "ctrl",
                              "alt"
                            ]
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "kind",
                        "target"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "key"
                        },
                        "keys": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "keys"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "type"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "code",
              "check",
              "hint",
              "mistake_actions"
            ],
            "additionalProperties": false
          }
        },
        "mistake_actions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "click"
                    },
                    "target": {
                      "$ref": "#/$defs/generic_target"
                    },
                    "modifiers": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "shift",
                          "ctrl",
                          "alt"
                        ]
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "kind",
                    "target"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "key"
                    },
                    "keys": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "keys"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "type"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "artifact_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.odt$"
              },
              "mimetype": {
                "const": "application/vnd.oasis.opendocument.text"
              },
              "heading": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "style_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outline_level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "text",
                  "style_name",
                  "outline_level"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "filename",
              "mimetype",
              "heading"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "goal",
        "help_ladder",
        "expected_actions",
        "checks",
        "known_errors_extra",
        "mistake_actions"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "generic_target": {
      "type": "object",
      "description": "Cible descriptive résolue à chaque fois dans l'arbre d'accessibilité ou par Holo ; jamais de ref ni de pixels.",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Chaîne d'ancêtres « role:nom » de la racine de fenêtre vers la cible."
        },
        "app_region": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "element_exists"
            },
            "params": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/generic_target"
                },
                "present": {
                  "type": "boolean",
                  "default": true
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "element_value"
            },
            "params": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/generic_target"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "match": {
                  "enum": [
                    "equals",
                    "contains",
                    "regex"
                  ],
                  "default": "equals"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "target",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "element_state"
            },
            "params": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/generic_target"
                },
                "states": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "focused",
                      "selected",
                      "checked",
                      "enabled",
                      "expanded",
                      "visible",
                      "editable",
                      "pressed",
                      "busy"
                    ]
                  },
                  "uniqueItems": true
                },
                "absent_states": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "focused",
                      "selected",
                      "checked",
                      "enabled",
                      "expanded",
                      "visible",
                      "editable",
                      "pressed",
                      "busy"
                    ]
                  },
                  "uniqueItems": true
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "states"
                  ],
                  "properties": {
                    "states": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "absent_states"
                  ],
                  "properties": {
                    "absent_states": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "window_title"
            },
            "params": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "match": {
                  "enum": [
                    "equals",
                    "contains",
                    "regex"
                  ],
                  "default": "contains"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "visual_assert"
            },
            "params": {
              "type": "object",
              "properties": {
                "assertion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Question fermée oui/non posée à Holo sur une capture fraîche de la fenêtre."
                },
                "region": {
                  "type": "object",
                  "description": "Zone de la fenêtre en millièmes (0-1000).",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                },
                "min_confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.8
                }
              },
              "required": [
                "assertion"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
