{
  "name": "rio-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && npm run build:landing && wrangler dev --local-upstream 127.0.0.1:8787",
    "deploy": "npm run build:web && npm run build:landing && wrangler deploy",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build:web": "vite build --config web/vite.config.ts",
    "build:landing": "cd ../landing && npm ci --silent && VITE_APP_URL= npx vite build --base /landing/ --outDir ../platform/web/dist/landing --emptyOutDir",
    "migration:auth": "node --experimental-strip-types --experimental-sqlite --no-warnings scripts/auth-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply rio --local",
    "db:migrate": "wrangler d1 migrations apply rio --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "hai-agents": "^1.3.2",
    "hono": "^4.13.17",
    "kysely": "^0.29.8",
    "kysely-d1": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
