# H Company key: https://platform.hcompany.ai/settings/api-keys
HAI_API_KEY=hk-...

# Optional: which Holo models to use
# HOLO_FAST_MODEL=holo4-35b-a3b    # element localization + step checks (fast)
# HOLO_SMART_MODEL=holo4-27b       # tutorial generation
# No paid credits? Set both to holo3-1-35b-a3b (free, 10 req/min)

# Speech-to-text (Gladia Live): https://app.gladia.io
GLADIA_API_KEY=

# Text-to-speech model (Phonon). Gated: needs HF_TOKEN or `hf auth login`.
# PHONON_MODEL=hf://gradium/phonon-40m-multilingual
