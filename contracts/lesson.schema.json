{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcompany-hack.invalid/contracts/lesson.schema.json",
  "title": "lesson",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "blender_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "pending",
        "failed",
        "proven"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "window_title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "check": {
            "$ref": "#/$defs/check"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/$defs/blender_target"
              },
              {
                "$ref": "#/$defs/generic_target"
              }
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "audio_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "check": {
                  "$ref": "#/$defs/check"
                },
                "hint": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "check",
                "hint"
              ],
              "additionalProperties": false
            }
          },
          "procedure_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
          },
          "proof": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "pending",
                  "failed",
                  "proven"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
              },
              "ui_path_verified": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "method",
              "evidence_ref",
              "ui_path_verified"
            ],
            "additionalProperties": false
          },
          "challenge": {
            "type": "boolean",
            "default": false
          },
          "help": {
            "type": "object",
            "properties": {
              "menu_id": {
                "type": "string",
                "minLength": 1
              },
              "safe_demo": {
                "type": "boolean",
                "default": false
              },
              "checkpoint_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "safe_demo": {
                      "const": true
                    }
                  },
                  "required": [
                    "safe_demo"
                  ]
                },
                "then": {
                  "required": [
                    "checkpoint_id"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "skill_id",
          "instruction",
          "preconditions",
          "check",
          "target",
          "why",
          "audio_ref",
          "known_errors",
          "procedure_ref",
          "proof"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "proof": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+$"
        },
        "ui_path_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "evidence_ref",
        "ui_path_verified"
      ],
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "description": "Application enseignée (v2). Pour Blender, id `blender` et version = blender_version.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sensor": {
          "enum": [
            "addon",
            "accessibility",
            "vision",
            "auto"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "sensor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "lesson_id",
    "revision",
    "title",
    "language",
    "status",
    "source",
    "skills",
    "steps",
    "proof"
  ],
  "additionalProperties": false,
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {"const": "calc.cell_formula"},
            "params": {
              "type": "object",
              "properties": {
                "sheet": {"type": "string", "minLength": 1},
                "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"},
                "formula": {"type": "string", "minLength": 2, "pattern": "^="},
                "value": {"type": "number"}
              },
              "required": ["sheet", "cell", "formula", "value"],
              "additionalProperties": false
            }
          },
          "required": ["name", "params"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {"const": "calc.range_bold"},
            "params": {
              "type": "object",
              "properties": {
                "sheet": {"type": "string", "minLength": 1},
                "range": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"},
                "bold": {"type": "boolean", "default": true}
              },
              "required": ["sheet", "range"],
              "additionalProperties": false
            }
          },
          "required": ["name", "params"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {"const": "calc.chart_source"},
            "params": {
              "type": "object",
              "properties": {
                "sheet": {"type": "string", "minLength": 1},
                "range": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"}
              },
              "required": ["sheet", "range"],
              "additionalProperties": false
            }
          },
          "required": ["name", "params"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "object_exists",
                "blender.object_exists"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "primitive"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "object_count",
                "blender.object_count"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "count"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "modifier_present",
                "blender.modifier_present"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                },
                "modifier_type": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": [
                          "number",
                          "boolean",
                          "string"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    ]
                  }
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "modifier_type"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "material_color",
                "blender.material_color"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                },
                "color": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "color"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "shading_smooth",
                "blender.shading_smooth"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                },
                "smooth": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "mode_is",
                "blender.mode_is"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "selection",
                "blender.selection"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                },
                "active": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "enum": [
                "object_transform",
                "blender.object_transform"
              ]
            },
            "params": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "primitive": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "anyOf": [
                {
                  "required": [
                    "location"
                  ]
                },
                {
                  "required": [
                    "scale"
                  ]
                },
                {
                  "required": [
                    "rotation"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "element_exists"
            },
            "params": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/generic_target"
                },
                "present": {
                  "type": "boolean",
                  "default": true
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "element_value"
            },
            "params": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/generic_target"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "match": {
                  "enum": [
                    "equals",
                    "contains",
                    "regex"
                  ],
                  "default": "equals"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "target",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "element_state"
            },
            "params": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/generic_target"
                },
                "states": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "focused",
                      "selected",
                      "checked",
                      "enabled",
                      "expanded",
                      "visible",
                      "editable",
                      "pressed",
                      "busy"
                    ]
                  },
                  "uniqueItems": true
                },
                "absent_states": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "focused",
                      "selected",
                      "checked",
                      "enabled",
                      "expanded",
                      "visible",
                      "editable",
                      "pressed",
                      "busy"
                    ]
                  },
                  "uniqueItems": true
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "states"
                  ],
                  "properties": {
                    "states": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "absent_states"
                  ],
                  "properties": {
                    "absent_states": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "window_title"
            },
            "params": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "match": {
                  "enum": [
                    "equals",
                    "contains",
                    "regex"
                  ],
                  "default": "contains"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "visual_assert"
            },
            "params": {
              "type": "object",
              "properties": {
                "assertion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Question fermée oui/non posée à Holo sur une capture fraîche de la fenêtre."
                },
                "region": {
                  "type": "object",
                  "description": "Zone de la fenêtre en millièmes (0-1000).",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                },
                "min_confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.8
                }
              },
              "required": [
                "assertion"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        }
      ]
    },
    "blender_target": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "area_type": {
          "type": "string",
          "minLength": 1
        },
        "region_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description",
        "area_type",
        "region_type"
      ],
      "additionalProperties": false
    },
    "generic_target": {
      "type": "object",
      "description": "Cible descriptive résolue à chaque fois dans l'arbre d'accessibilité ou par Holo ; jamais de ref ni de pixels.",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Chaîne d'ancêtres « role:nom » de la racine de fenêtre vers la cible."
        },
        "app_region": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "blender_version"
          ]
        },
        {
          "required": [
            "app"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "blender_version"
        ],
        "not": {
          "required": [
            "app"
          ]
        },
        "properties": {
          "steps": {
            "items": {
              "properties": {
                "preconditions": {
                  "required": [
                    "mode"
                  ]
                },
                "target": {
                  "$ref": "#/$defs/blender_target"
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "app"
        ]
      }
    }
  ]
}
