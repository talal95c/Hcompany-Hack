{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcompany-hack.invalid/contracts/desktop-ws.schema.json",
  "title": "desktop-ws",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "hello",
        "permissions",
        "ptt.start",
        "ptt.stop",
        "audio.chunk",
        "capture.result",
        "input.result",
        "user.intent",
        "command",
        "lesson.state",
        "ping",
        "pong",
        "error",
        "capture.request",
        "a11y.request",
        "a11y.result",
        "app.focus",
        "highlight.rect"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "message_id",
    "reply_to",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "hello"
        },
        "payload": {
          "type": "object",
          "properties": {
            "app_version": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "app_version",
            "platform",
            "capabilities"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "permissions"
        },
        "payload": {
          "type": "object",
          "properties": {
            "screen": {
              "type": "boolean"
            },
            "accessibility": {
              "type": "boolean"
            },
            "microphone": {
              "type": "boolean"
            }
          },
          "required": [
            "screen",
            "accessibility",
            "microphone"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ptt.start"
        },
        "payload": {
          "type": "object",
          "properties": {
            "utterance_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "utterance_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ptt.stop"
        },
        "payload": {
          "type": "object",
          "properties": {
            "utterance_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "utterance_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "audio.chunk"
        },
        "payload": {
          "type": "object",
          "properties": {
            "utterance_id": {
              "type": "string",
              "minLength": 1
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "encoding": {
              "type": "string",
              "minLength": 1
            },
            "sample_rate": {
              "type": "integer",
              "minimum": 1
            },
            "data_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "utterance_id",
            "sequence",
            "encoding",
            "sample_rate",
            "data_base64"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "capture.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "capture_id": {
              "type": "string",
              "minLength": 1
            },
            "ui_revision": {
              "type": "integer",
              "minimum": 0
            },
            "crop": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "monitor_id": {
              "type": "string",
              "minLength": 1
            },
            "image_ref": {
              "type": "string",
              "minLength": 1
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "app": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "capture_id",
            "ui_revision",
            "crop",
            "scale",
            "monitor_id",
            "image_ref"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "input.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "command_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "ok",
                "rejected",
                "failed",
                "expired"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "command_id",
            "status",
            "detail"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "user.intent"
        },
        "payload": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "Texte utilisateur ; pour fais-le, source bouton et chaîne JSON {intent: fais-le, consent_token: UUID}, avec delegation_confirmed et wants_to_learn optionnels. Le token natif ne passe jamais par la WebView.",
              "minLength": 1
            },
            "source": {
              "enum": [
                "clavier",
                "bouton"
              ]
            }
          },
          "required": [
            "text",
            "source"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "command"
        },
        "payload": {
          "$ref": "commands.schema.json"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "lesson.state"
        },
        "payload": {
          "type": "object",
          "properties": {
            "step_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "READY",
                "OBSERVING",
                "CHECKING",
                "HELP",
                "ACTING",
                "PASSED",
                "PAUSED",
                "COMPLETE"
              ]
            },
            "instruction": {
              "type": "string"
            },
            "help_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "ui_revision": {
              "type": "integer",
              "minimum": 0,
              "description": "Révision UI du capteur Blender ; le desktop la recopie dans capture.result sans incrément local."
            },
            "transcript": {
              "type": "string"
            },
            "transcript_final": {
              "type": "boolean"
            }
          },
          "required": [
            "step_id",
            "status",
            "instruction",
            "help_level"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ping"
        },
        "payload": {
          "type": "object",
          "properties": {
            "nonce": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "nonce"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "pong"
        },
        "payload": {
          "type": "object",
          "properties": {
            "nonce": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "nonce"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "error"
        },
        "payload": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "capture.request"
        },
        "payload": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "crop": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "ui_revision": {
              "type": "integer",
              "minimum": 0
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "enum": [
                "rect",
                "window"
              ],
              "default": "rect",
              "description": "window : fenêtre de `app` entière (crop null) ; rect : crop écran."
            },
            "app": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "request_id",
            "crop",
            "ui_revision",
            "generation"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "window"
                  }
                },
                "required": [
                  "scope"
                ]
              },
              "then": {
                "required": [
                  "app"
                ],
                "properties": {
                  "crop": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "a11y.request"
        },
        "payload": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "enum": [
                "snapshot",
                "find",
                "get",
                "action"
              ]
            },
            "app": {
              "type": "string",
              "minLength": 1
            },
            "root": {
              "type": "string",
              "minLength": 1
            },
            "query": {
              "$ref": "#/$defs/a11y_query"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "enum": [
                "press",
                "focus",
                "set_value",
                "toggle",
                "select",
                "expand",
                "collapse",
                "scroll_into_view"
              ]
            },
            "value": {
              "type": "string"
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "consent_token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "request_id",
            "op",
            "app"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "find"
                  }
                }
              },
              "then": {
                "required": [
                  "query"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "get"
                  }
                }
              },
              "then": {
                "required": [
                  "ref"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "action"
                  }
                }
              },
              "then": {
                "required": [
                  "ref",
                  "action",
                  "consent_token"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "action"
                      ]
                    },
                    {
                      "required": [
                        "consent_token"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "set_value"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "a11y.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "snapshot_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "nodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/a11y_node"
              }
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "STALE_REF",
                    "AMBIGUOUS_TARGET",
                    "APP_NOT_FOUND",
                    "PERMISSION_DENIED",
                    "TIMEOUT"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "request_id",
            "snapshot_id",
            "complete",
            "nodes"
          ],
          "additionalProperties": false,
          "if": {
            "required": [
              "error"
            ]
          },
          "then": {
            "properties": {
              "complete": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "snapshot_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "app.focus"
        },
        "payload": {
          "type": "object",
          "properties": {
            "app_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "window_title": {
              "type": "string"
            },
            "window_bounds": {
              "$ref": "#/$defs/rect_px"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "accessibility": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            }
          },
          "required": [
            "app_id",
            "name",
            "window_title",
            "window_bounds",
            "scale"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "highlight.rect"
        },
        "payload": {
          "$ref": "commands.schema.json#/$defs/highlight_rect_payload"
        }
      }
    }
  ],
  "$defs": {
    "rect_px": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "a11y_query": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "value": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "focused",
              "selected",
              "checked",
              "enabled",
              "expanded",
              "visible",
              "editable",
              "pressed",
              "busy"
            ]
          },
          "uniqueItems": true
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "a11y_node": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "focused",
              "selected",
              "checked",
              "enabled",
              "expanded",
              "visible",
              "editable",
              "pressed",
              "busy"
            ]
          },
          "uniqueItems": true
        },
        "bounds": {
          "$ref": "#/$defs/rect_px"
        },
        "parent_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ref",
        "role",
        "name",
        "states",
        "bounds"
      ],
      "additionalProperties": false
    }
  }
}
