{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcompany-hack.invalid/contracts/desktop-ws.schema.json",
  "title": "desktop-ws",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "hello",
        "permissions",
        "ptt.start",
        "ptt.stop",
        "audio.chunk",
        "capture.result",
        "input.result",
        "user.intent",
        "command",
        "lesson.state",
        "ping",
        "pong",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "message_id",
    "reply_to",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "hello"
        },
        "payload": {
          "type": "object",
          "properties": {
            "app_version": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "app_version",
            "platform",
            "capabilities"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "permissions"
        },
        "payload": {
          "type": "object",
          "properties": {
            "screen": {
              "type": "boolean"
            },
            "accessibility": {
              "type": "boolean"
            },
            "microphone": {
              "type": "boolean"
            }
          },
          "required": [
            "screen",
            "accessibility",
            "microphone"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ptt.start"
        },
        "payload": {
          "type": "object",
          "properties": {
            "utterance_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "utterance_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ptt.stop"
        },
        "payload": {
          "type": "object",
          "properties": {
            "utterance_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "utterance_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "audio.chunk"
        },
        "payload": {
          "type": "object",
          "properties": {
            "utterance_id": {
              "type": "string",
              "minLength": 1
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "encoding": {
              "type": "string",
              "minLength": 1
            },
            "sample_rate": {
              "type": "integer",
              "minimum": 1
            },
            "data_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "utterance_id",
            "sequence",
            "encoding",
            "sample_rate",
            "data_base64"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "capture.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "capture_id": {
              "type": "string",
              "minLength": 1
            },
            "ui_revision": {
              "type": "integer",
              "minimum": 0
            },
            "crop": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "monitor_id": {
              "type": "string",
              "minLength": 1
            },
            "image_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "capture_id",
            "ui_revision",
            "crop",
            "scale",
            "monitor_id",
            "image_ref"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "input.result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "command_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "ok",
                "rejected",
                "failed",
                "expired"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "command_id",
            "status",
            "detail"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "user.intent"
        },
        "payload": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "Texte utilisateur ; pour fais-le, source bouton et chaîne JSON {intent: fais-le, consent_token: UUID}, avec delegation_confirmed et wants_to_learn optionnels. Le token natif ne passe jamais par la WebView.",
              "minLength": 1
            },
            "source": {
              "enum": [
                "clavier",
                "bouton"
              ]
            }
          },
          "required": [
            "text",
            "source"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "command"
        },
        "payload": {
          "$ref": "commands.schema.json"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "lesson.state"
        },
        "payload": {
          "type": "object",
          "properties": {
            "step_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "READY",
                "OBSERVING",
                "CHECKING",
                "HELP",
                "ACTING",
                "PASSED",
                "PAUSED",
                "COMPLETE"
              ]
            },
            "instruction": {
              "type": "string"
            },
            "help_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "ui_revision": {
              "type": "integer",
              "minimum": 0,
              "description": "Révision UI du capteur Blender ; le desktop la recopie dans capture.result sans incrément local."
            }
          },
          "required": [
            "step_id",
            "status",
            "instruction",
            "help_level"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ping"
        },
        "payload": {
          "type": "object",
          "properties": {
            "nonce": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "nonce"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "pong"
        },
        "payload": {
          "type": "object",
          "properties": {
            "nonce": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "nonce"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "error"
        },
        "payload": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
