{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hcompany Guide",
  "version": "0.1.0",
  "identifier": "ai.hcompany.guide",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "guide",
        "title": "Guide Blender",
        "width": 480,
        "height": 160,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
