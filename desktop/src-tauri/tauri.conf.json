{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hcompany Guide",
  "version": "0.1.0",
  "identifier": "ai.hcompany.guide",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "guide",
        "title": "Guide Blender",
        "width": 1024,
        "height": 768,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "focus": false,
        "skipTaskbar": true,
        "contentProtected": true
      },
      {
        "label": "pill",
        "title": "Guide — commandes",
        "url": "index.html#pill",
        "x": 580,
        "y": 24,
        "width": 430,
        "height": 138,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "focus": false,
        "skipTaskbar": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
