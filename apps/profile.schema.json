{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "vocabulary",
    "docs_domains",
    "jev_context",
    "answer_fields",
    "default_sensor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jev_context": {
      "type": "string",
      "minLength": 1
    },
    "answer_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "default_sensor": {
      "enum": [
        "addon",
        "accessibility",
        "vision",
        "auto"
      ]
    }
  }
}
